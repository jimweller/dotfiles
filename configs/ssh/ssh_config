# Tell SSH to ignore unknown options (like UseKeychain on Linux)
Host *
  IgnoreUnknown UseKeychain

# Git hosts. id_jim is the key shipped in the quiver bootstrap tarball, so a
# fresh bolt can clone before the full keyring is restored. IdentitiesOnly is
# left off so machines with the whole keyring still fall back to other keys.
Host github.com ssh.dev.azure.com vs-ssh.visualstudio.com
  User git
  IdentityFile ~/.ssh/id_jim

# macOS-specific includes (only exists on macOS)
Include ~/.colima/ssh_config

# DevPod Start vscode-remote-try-cpp.devpod
Host vscode-remote-try-cpp.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user vscode vscode-remote-try-cpp
  User vscode
# DevPod End vscode-remote-try-cpp.devpod

# DevPod Start claude-flow.devpod
Host claude-flow.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user node claude-flow
  User node
# DevPod End claude-flow.devpod

# Cross-platform settings with macOS-specific UseKeychain
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly no

Host jimweller.com
  HostName jimweller.com
  User jimwelle
  IdentityFile ~/.ssh/id_jim
  IdentitiesOnly yes


