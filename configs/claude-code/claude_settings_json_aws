{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "permissions": {
    "deny": [
      "Read(~/.config/sops/age/keys.txt)",
      "Read(**/keys.txt)",
      "Read(**/*.age)",
      "Skill(claude-mem:babysit)",
      "Skill(claude-mem:cloud-sync)",
      "Skill(claude-mem:design-is)",
      "Skill(claude-mem:do)",
      "Skill(claude-mem:how-it-works)",
      "Skill(claude-mem:learn-codebase)",
      "Skill(claude-mem:make-plan)",
      "Skill(claude-mem:oh-my-issues)",
      "Skill(claude-mem:pathfinder)",
      "Skill(claude-mem:smart-explore)",
      "Skill(claude-mem:standup)",
      "Skill(claude-mem:version-bump)",
      "Skill(claude-mem:weekly-digests)",
      "Skill(claude-mem:what-the)",
      "Skill(claude-mem:wowerpoint)"
    ]
  },
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "CLAUDE_CODE_USE_FOUNDRY": "0",
    "CLAUDE_CODE_SHELL": "bash",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "global.anthropic.claude-fable-5[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "global.anthropic.claude-opus-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "global.anthropic.claude-sonnet-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "global.anthropic.claude-haiku-4-5",
    "ANTHROPIC_MODEL": "opus",
    "CLAUDE_CODE_SUBAGENT_MODEL": "global.anthropic.claude-sonnet-5",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40",
    "ENABLE_TOOL_SEARCH": "auto:1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_COST_WARNINGS": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ingest-transcript.sh"
          },
          {
            "type": "command",
            "command": "agent-deck hook-handler"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ingest-transcript.sh"
          }
        ]
      },
      {
        "matcher": "prompt_input_exit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ingest-transcript.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-phrase-guard.sh"
          },
          {
            "type": "command",
            "command": "agent-deck hook-handler"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh aws"
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true,
    "mcg-atlassian@sead-claude-marketplace": true,
    "mcg-lookup@sead-claude-marketplace": true,
    "beads@beads-marketplace": true,
    "claude-mem@thedotmack": true,
    "superpowers@jimweller": false,
    "mcg-status-updates@devx-claude-marketplace": false
  },
  "extraKnownMarketplaces": {
    "devx-claude-marketplace": {
      "source": {
        "source": "git",
        "url": "https://dev.azure.com/mcgsead/devx-internal/_git/devx-claude-marketplace"
      },
      "autoUpdate": true
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    },
    "jimweller": {
      "source": {
        "source": "github",
        "repo": "jimweller/claude-marketplace"
      }
    },
    "azure-skills": {
      "source": {
        "source": "github",
        "repo": "microsoft/azure-skills"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "CLANKING"
    ]
  },
  "effortLevel": "xhigh",
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "preferredNotifChannel": "notifications_disabled",
  "terminalProgressBarEnabled": false
}