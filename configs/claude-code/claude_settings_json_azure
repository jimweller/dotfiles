{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoUpdatesChannel": "latest",
  "awaySummaryEnabled": false,
  "cleanupPeriodDays": 90,
  "effortLevel": "high",
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "claude-mem@jimweller": true,
    "mcg-atlassian@sead-claude-marketplace": true,
    "mcg-lookup@sead-claude-marketplace": true,
    "mcg-status-updates@devx-claude-marketplace": false,
    "ralph-loop@claude-plugins-official": true,
    "superpowers@jimweller": false
  },
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5[1m]",
    "ANTHROPIC_MODEL": "opus",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_SHELL": "bash",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5",
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "CLAUDE_CODE_USE_FOUNDRY": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "auto:1"
  },
  "extraKnownMarketplaces": {
    "azure-skills": {
      "source": {
        "repo": "microsoft/azure-skills",
        "source": "github"
      }
    },
    "beads-marketplace": {
      "source": {
        "repo": "gastownhall/beads",
        "source": "github"
      }
    },
    "devx-claude-marketplace": {
      "autoUpdate": true,
      "source": {
        "source": "git",
        "url": "https://dev.azure.com/mcgsead/devx-internal/_git/devx-claude-marketplace"
      }
    },
    "jimweller": {
      "source": {
        "repo": "jimweller/claude-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agent-deck hook-handler",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "agent-deck hook-handler",
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/ingest-transcript.sh",
            "type": "command"
          },
          {
            "command": "agent-deck hook-handler",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/rtk-rewrite.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/ingest-transcript.sh",
            "type": "command"
          }
        ],
        "matcher": "clear"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/ingest-transcript.sh",
            "type": "command"
          }
        ],
        "matcher": "prompt_input_exit"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "agent-deck hook-handler",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agent-deck hook-handler",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/jimweller/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/stop-phrase-guard.sh",
            "type": "command"
          },
          {
            "command": "agent-deck hook-handler",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agent-deck hook-handler",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(~/.config/sops/age/keys.txt)",
      "Read(**/keys.txt)",
      "Read(**/*.age)"
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "CLANKING"
    ]
  },
  "statusLine": {
    "command": "~/.claude/statusline-command.sh azure",
    "type": "command"
  },
  "terminalProgressBarEnabled": false,
  "theme": "dark-daltonized",
  "tui": "fullscreen"
}