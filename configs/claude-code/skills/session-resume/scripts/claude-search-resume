#!/usr/bin/env bash

# Claude conversation finder - Cross-platform (Linux/macOS)
# Usage: claude-search-resume [keyword] [--global] [--from "YYYY-MM-DD HH:MM"] [--to "YYYY-MM-DD HH:MM"]

# Detect OS and set CLAUDE_DIR
case "$(uname -s)" in
    Linux*)  CLAUDE_DIR="$HOME/.claude" ;;
    Darwin*) CLAUDE_DIR="$HOME/.claude" ;;
    CYGWIN*|MINGW*|MSYS*) CLAUDE_DIR="$USERPROFILE/.claude" ;;
    *) CLAUDE_DIR="$HOME/.claude" ;;
esac

PROJECTS_DIR="$CLAUDE_DIR/projects"

# Check if Claude directory exists
if [ ! -d "$PROJECTS_DIR" ]; then
    echo "Error: Claude projects directory not found at $PROJECTS_DIR"
    echo "Make sure Claude Code is installed and has been used at least once."
    exit 1
fi

# Cross-platform date parsing
parse_date_to_epoch() {
    local date_str="$1"
    if date --version >/dev/null 2>&1; then
        # GNU date (Linux)
        date -d "$date_str" +%s 2>/dev/null
    else
        # BSD date (macOS)
        # Try ISO format first, then other formats
        date -j -f "%Y-%m-%dT%H:%M:%S" "$date_str" +%s 2>/dev/null || \
        date -j -f "%Y-%m-%d %H:%M" "$date_str" +%s 2>/dev/null || \
        date -j -f "%Y-%m-%d" "$date_str" +%s 2>/dev/null
    fi
}

format_date() {
    local date_str="$1"
    if date --version >/dev/null 2>&1; then
        # GNU date (Linux)
        date -d "$date_str" "+%Y-%m-%d %H:%M" 2>/dev/null
    else
        # BSD date (macOS) - parse ISO timestamp
        local epoch=$(parse_date_to_epoch "$date_str")
        if [ -n "$epoch" ]; then
            date -j -f "%s" "$epoch" "+%Y-%m-%d %H:%M" 2>/dev/null
        fi
    fi
}

KEYWORD=""
FILTER_GLOBAL=false
FROM_DATE=""
TO_DATE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --global) FILTER_GLOBAL=true; shift ;;
        --from) FROM_DATE="$2"; shift 2 ;;
        --to) TO_DATE="$2"; shift 2 ;;
        --help|-h)
            echo "Usage: claude-search-resume [keyword] [options]"
            echo ""
            echo "Options:"
            echo "  --global              Search all projects (default: current directory only)"
            echo "  --from \"YYYY-MM-DD\"   Filter from date"
            echo "  --to \"YYYY-MM-DD\"     Filter to date"
            echo "  --help, -h            Show this help"
            echo ""
            echo "Examples:"
            echo "  claude-search-resume                    # Recent conversations in current project"
            echo "  claude-search-resume \"auth\" --global   # Search 'auth' in all projects"
            echo "  claude-search-resume --from \"2026-01-13\" --global"
            exit 0
            ;;
        *) KEYWORD="$1"; shift ;;
    esac
done

# Convert multi-word keyword into OR regex: "elephant bob" → "elephant|bob"
if [ -n "$KEYWORD" ]; then
    KEYWORD=$(echo "$KEYWORD" | sed 's/  */ /g; s/ /|/g')
fi

CURRENT_DIR=$(pwd)

echo "Finding conversations..."
[ -n "$KEYWORD" ] && echo "Filtering by: $KEYWORD"
[ "$FILTER_GLOBAL" = false ] && echo "In: $CURRENT_DIR" || echo "Searching globally"
echo ""

HAS_RG=false
command -v rg >/dev/null 2>&1 && HAS_RG=true

MAX_RESULTS=10
RG_GLOB_ARGS=(--glob '*.jsonl' --glob '!**/subagents/**')

# --from/--to are compared as ISO strings rather than epochs. Transcript
# timestamps and the bounds are both naive wall-clock text, so a lexicographic
# compare gives the same answer as the old date(1) round-trip without spawning
# two processes per candidate file.
normalize_bound() {
    local d="${1/ /T}"
    case "$d" in
        *T*) ;;
        *) if [ "$2" = "to" ]; then d="${d}T23:59:59"; else d="${d}T00:00:00"; fi ;;
    esac
    printf '%s' "$d"
}

FROM_BOUND=""
TO_BOUND=""
[ -n "$FROM_DATE" ] && FROM_BOUND=$(normalize_bound "$FROM_DATE" from)
[ -n "$TO_DATE" ] && TO_BOUND=$(normalize_bound "$TO_DATE" to)

CANDIDATES=$(mktemp)
META=$(mktemp)
MATCHED=$(mktemp)
trap 'rm -f "$CANDIDATES" "$META" "$MATCHED"' EXIT

# Stage 1: rg picks candidate files. This is the only keyword scan.
if [ "$HAS_RG" = true ]; then
    if [ -n "$KEYWORD" ]; then
        rg -li --max-columns 0 "$KEYWORD" "$PROJECTS_DIR" "${RG_GLOB_ARGS[@]}" 2>/dev/null
    else
        rg -l --max-columns 0 '"cwd"' "$PROJECTS_DIR" "${RG_GLOB_ARGS[@]}" 2>/dev/null
    fi | grep -v '/agent-' > "$CANDIDATES"
else
    find "$PROJECTS_DIR" -name '*.jsonl' -type f -size +0 2>/dev/null \
        | grep -v '/agent-' | grep -v '/subagents/' > "$CANDIDATES"
    if [ -n "$KEYWORD" ]; then
        while IFS= read -r f; do
            grep -qiE "$KEYWORD" "$f" 2>/dev/null && printf '%s\n' "$f"
        done < "$CANDIDATES" > "$CANDIDATES.kw"
        mv "$CANDIDATES.kw" "$CANDIDATES"
    fi
fi

# Stage 2: one streaming pass yields the sort key and project path for every
# candidate. A session's last line is often a metadata record with no timestamp
# (last-prompt, cost-state, permission-mode, mode, ai-title, custom-title,
# atis-latch), which is why the last line alone is not a usable sort key.
# Measured over 5855 files / 3.6G: per-file tail 48.6s, this pass 3.0s.
if [ -s "$CANDIDATES" ]; then
    if [ "$HAS_RG" = true ]; then
        tr '\n' '\0' < "$CANDIDATES" \
            | xargs -0 rg -o --no-heading --with-filename '"(cwd|timestamp)":"[^"]*"' 2>/dev/null
    else
        tr '\n' '\0' < "$CANDIDATES" \
            | xargs -0 grep -oHE '"(cwd|timestamp)":"[^"]*"' 2>/dev/null
    fi | awk '
        {
            if (match($0, /:"timestamp":"/)) {
                f = substr($0, 1, RSTART - 1)
                v = substr($0, RSTART + RLENGTH); sub(/"$/, "", v)
                ts[f] = v
                next
            }
            if (match($0, /:"cwd":"/)) {
                f = substr($0, 1, RSTART - 1)
                v = substr($0, RSTART + RLENGTH); sub(/"$/, "", v)
                if (!(f in cw)) cw[f] = v
            }
        }
        END { for (f in ts) if (f in cw) printf "%s\t%s\t%s\n", ts[f], cw[f], f }
    ' > "$META"
fi

# Stage 3: filter, then sort. Nothing is truncated here, so the reported count
# is the true number of matches.
while IFS=$'\t' read -r ts cwd path; do
    [ -z "$ts" ] && continue
    [ "$FILTER_GLOBAL" = false ] && [ "$cwd" != "$CURRENT_DIR" ] && continue
    [ -n "$FROM_BOUND" ] && [[ "$ts" < "$FROM_BOUND" ]] && continue
    [ -n "$TO_BOUND" ] && [[ "$ts" > "$TO_BOUND" ]] && continue
    printf '%s\t%s\t%s\n' "$ts" "$cwd" "$path"
done < "$META" | sort -r > "$MATCHED"

TOTAL=$(wc -l < "$MATCHED" | tr -d ' ')

if [ "$TOTAL" -eq 0 ]; then
    echo "No conversations found"
    exit 0
fi

if [ -n "$KEYWORD" ]; then
    echo "$TOTAL session(s) matched"
else
    echo "$TOTAL session(s) found"
fi
echo ""

count=0
while IFS=$'\t' read -r ts cwd path; do
    count=$((count + 1))
    session_id=$(basename "$path" .jsonl)

    date_str=$(format_date "$ts")
    [ -z "$date_str" ] && date_str="?"

    if [ "$HAS_RG" = true ]; then
        user_line=$(rg -m1 --max-columns 0 '"type":"user"' "$path" 2>/dev/null)
        msg_count=$(rg -c '"type":"user"' "$path" 2>/dev/null || echo 0)
    else
        user_line=$(grep -m1 '"type":"user"' "$path" 2>/dev/null)
        msg_count=$(grep -c '"type":"user"' "$path" 2>/dev/null || echo 0)
    fi
    preview=$(echo "$user_line" | sed -n 's/.*"type":"user".*"text":"\([^"]*\)".*/\1/p')
    [ -z "$preview" ] && preview=$(echo "$user_line" | sed -n 's/.*"type":"user".*"content":"\([^"]*\)".*/\1/p')
    preview=$(echo "$preview" | tr '\n\t|' '   ' | cut -c1-80)

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "$count. [$date_str] $cwd ($msg_count msgs)"
    [ -n "$preview" ] && echo "   💬 $preview"
    echo "   ▶ claude --resume $session_id"
done < <(head -"$MAX_RESULTS" "$MATCHED")
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ "$TOTAL" -gt "$MAX_RESULTS" ]; then
    echo ""
    echo "Showing the $MAX_RESULTS most recent of $TOTAL matches."
    echo "To narrow: use a longer or more specific search string, or add a date"
    echo "range, e.g. --from \"2026-03-01\" --to \"2026-03-31\""
fi